{
  "name": "com.thomassidor.lightkeeper",
  "version": "0.5.0",
  "description": "Homey Pro app that points any paired remote, switch or dial at any paired lights, and puts those lights on a schedule \u2014 without writing a single Flow.",
  "license": "MIT",
  "author": {
    "name": "Thomas Ren\u00e9 Sidor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomassidor/lightkeeper.git"
  },
  "homepage": "https://github.com/thomassidor/lightkeeper#readme",
  "bugs": {
    "url": "https://github.com/thomassidor/lightkeeper/issues"
  },
  "keywords": [
    "homey",
    "homey-app",
    "lighting",
    "zigbee",
    "matter",
    "remote-control",
    "schedule",
    "timer"
  ],
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "sync:views": "node scripts/sync-views.mjs",
    "sync:views:check": "node scripts/sync-views.mjs --check",
    "render:views": "node scripts/render-views.mjs",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/unit/**/*.test.ts\"",
    "validate": "homey app validate --level publish",
    "lint": "eslint ."
  },
  "dependencies": {
    "homey-api": "3.19.2"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.8",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "homey": "4.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0"
  }
}
