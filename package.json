{
  "name": "com.thomassidor.lightlink",
  "version": "0.1.0",
  "description": "Homey Pro app that turns any paired remote, switch or dial into a controller for any paired lights, without writing a single Flow.",
  "license": "MIT",
  "author": {
    "name": "Thomas Sidor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomassidor/lightlink.git"
  },
  "homepage": "https://github.com/thomassidor/lightlink#readme",
  "bugs": {
    "url": "https://github.com/thomassidor/lightlink/issues"
  },
  "keywords": [
    "homey",
    "homey-app",
    "lighting",
    "zigbee",
    "matter",
    "remote-control"
  ],
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/unit/**/*.test.ts\"",
    "validate": "homey app validate --level publish"
  },
  "dependencies": {
    "homey-api": "^3.19.2"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.8",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
