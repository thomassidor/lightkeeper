            "name": "controller",
            "title": {
              "en": "Controller",
              "da": "Betjening"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event",
              "da": "Hændelse"
            }
          }
        ],
        "id": "bridge_token_event"
