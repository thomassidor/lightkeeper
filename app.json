  "capabilities": {
    "lightkeeper_brightness": {
      "type": "number",
      "title": {
        "en": "Brightness now"
      },
      "desc": {
        "en": "The brightness this device wants its lights at right now, as a light is addressed: 0 to 1, the same scale Homey's \"Dim to\" card takes."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "chartType": "stepLine",
      "min": 0,
      "max": 1,
      "decimals": 2,
      "icon": "/assets/capabilities/dim.svg"
    },
    "lightkeeper_colour": {
      "type": "string",
      "title": {
        "en": "Colour now"
      },
      "desc": {
        "en": "The colour this device wants its colour-capable lights at right now, by name. Empty on a stretch of the curve that sets a colour temperature instead."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/light_hue.svg"
    },
    "lightkeeper_control": {
      "type": "enum",
      "title": {
        "en": "Lightkeeper control"
      },
      "desc": {
        "en": "How Lightkeeper controls this device's lights: after they turn on, before they turn on, or not at all."
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "insights": false,
      "values": [
        {
          "id": "after",
          "title": {
            "en": "Change lights after they turn on"
          }
        },
        {
          "id": "before",
          "title": {
            "en": "Set lights before they turn on"
          }
        },
        {
          "id": "none",
          "title": {
            "en": "Don’t change lights automatically"
          }
        }
      ],
      "icon": "/assets/capabilities/light_mode.svg"
    },
    "lightkeeper_daylight": {
      "type": "number",
      "title": {
        "en": "Daylight outside"
      },
      "desc": {
        "en": "How light it is outside, as this device reads it: 0 is fully dark, 1 is fully bright. Empty when it cannot tell."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "chartType": "spline",
      "min": 0,
      "max": 1,
      "decimals": 2,
      "icon": "/assets/capabilities/measure_luminance.svg"
    },
    "lightkeeper_temperature": {
      "type": "number",
      "title": {
        "en": "Colour temperature now"
      },
      "desc": {
        "en": "The colour temperature this device wants its lights at right now: 0 to 1, where 1 is the warmest, the same scale Homey's \"Set a temperature\" card takes."
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "chartType": "stepLine",
      "min": 0,
      "max": 1,
      "decimals": 2,
      "icon": "/assets/capabilities/light_temperature.svg"
    }
  }
