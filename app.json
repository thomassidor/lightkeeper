            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event",
              "da": "Hændelse"
            }
          },
          {
            "type": "number",
            "name": "value",
            "title": {
              "en": "Value",
              "da": "Værdi"
            },
            "min": -1000000,
            "max": 1000000,
            "step": 0.001
          }
        ],
        "id": "bridge_numeric_event"
      },
      {
        "title": {
          "en": "Receive controller event with a token value",
