    "setCredential": {
      "method": "POST",
      "path": "/credential"
    },
    "deleteCredential": {
      "method": "DELETE",
      "path": "/credential"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "sweepOrphans": {
      "method": "POST",
      "path": "/orphans"
    },
    "countOrphans": {
      "method": "GET",
      "path": "/orphans"
    }
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Receive controller event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] to controller [[controller]]"
        },
        "hint": {
          "en": "Used internally by Light Link. These cards appear in Flows that Light Link creates and maintains for you — you do not need to add them by hand, and editing them will disconnect your controller."
        },
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Controller"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_event"
      },
      {
        "title": {
          "en": "Receive numeric controller event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[value]] to controller [[controller]]"
        },
        "hint": {
          "en": "Used internally by Light Link, for events that carry an amount as a fixed value — for example one Flow per dial detent. Do not add or edit these by hand."
        },
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Controller"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          },
          {
            "type": "number",
            "name": "value",
            "title": {
              "en": "Value"
            },
            "min": -1000000,
            "max": 1000000,
            "step": 0.001
          }
        ],
        "id": "bridge_numeric_event"
      },
      {
        "title": {
          "en": "Receive controller event with a token value"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[droptoken]] to controller [[controller]]"
        },
        "hint": {
          "en": "Used internally by Light Link, for events whose amount arrives as a Flow token — for example a dial reporting how far it turned. Do not add or edit these by hand."
        },
        "droptoken": [
          "number"
        ],
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Controller"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_token_event"
      }
    ]
  },
