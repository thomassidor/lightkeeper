  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/"
    },
    "setCredential": {
      "method": "POST",
      "path": "/credential"
    },
    "deleteCredential": {
      "method": "DELETE",
      "path": "/credential"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "sweepOrphans": {
      "method": "POST",
      "path": "/orphans"
    },
    "countOrphans": {
      "method": "GET",
      "path": "/orphans"
    },
    "previewDevice": {
      "method": "POST",
      "path": "/devices/:id/preview"
    },
    "testPreStage": {
      "method": "POST",
      "path": "/devices/:id/prestage-test"
    },
    "tickCurves": {
      "method": "POST",
      "path": "/curves/tick"
    },
    "tickDaylight": {
      "method": "POST",
      "path": "/daylight/tick"
    },
    "testScheduleBoundary": {
      "method": "POST",
      "path": "/schedules/:id/test"
    },
    "setScheduleEntries": {
      "method": "POST",
      "path": "/schedules/:id/entries"
    },
    "testControllerFunction": {
      "method": "POST",
      "path": "/controllers/:id/test"
    }
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Receive Lightkeeper event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper. These cards appear in Flows that Lightkeeper creates and maintains for you — you do not need to add them by hand, and editing them will disconnect the device they belong to."
        },
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_event"
      },
      {
        "title": {
          "en": "Receive numeric Lightkeeper event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[value]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper, for events that carry an amount as a fixed value — for example one Flow per dial detent. Do not add or edit these by hand."
        },
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          },
          {
            "type": "number",
            "name": "value",
            "title": {
              "en": "Value"
            },
            "min": -1000000,
            "max": 1000000,
            "step": 0.001
          }
        ],
        "id": "bridge_numeric_event"
      },
      {
        "title": {
          "en": "Receive Lightkeeper event with a token value"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[droptoken]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper, for events whose amount arrives as a Flow token — for example a dial reporting how far it turned. Do not add or edit these by hand."
        },
        "droptoken": [
          "number"
        ],
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_token_event"
      }
    ]
  },
