  "flow": {
    "actions": [
      {
        "title": {
          "en": "Receive Lightkeeper event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper. These cards appear in Flows that Lightkeeper creates and maintains for you — you do not need to add them by hand, and editing them will disconnect the device they belong to."
        },
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_event"
      },
      {
        "title": {
          "en": "Receive numeric Lightkeeper event"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[value]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper, for events that carry an amount as a fixed value — for example one Flow per dial detent. Do not add or edit these by hand."
        },
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          },
          {
            "type": "number",
            "name": "value",
            "title": {
              "en": "Value"
            },
            "min": -1000000,
            "max": 1000000,
            "step": 0.001
          }
        ],
        "id": "bridge_numeric_event"
      },
      {
        "title": {
          "en": "Receive Lightkeeper event with a token value"
        },
        "titleFormatted": {
          "en": "Send event [[event_key]] with value [[droptoken]] to Lightkeeper device [[controller]]"
        },
        "hint": {
          "en": "Used internally by Lightkeeper, for events whose amount arrives as a Flow token — for example a dial reporting how far it turned. Do not add or edit these by hand."
        },
        "droptoken": [
          "number"
        ],
        "deprecated": true,
        "args": [
          {
            "type": "text",
            "name": "controller",
            "title": {
              "en": "Device"
            }
          },
          {
            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event"
            }
          }
        ],
        "id": "bridge_token_event"
      },
      {
        "title": {
          "en": "Set lights the Lightkeeper way"
        },
        "titleFormatted": {
          "en": "Set [[lights]] — colour from [[colour]], brightness from [[brightness]], [[power]]"
        },
        "hint": {
          "en": "Puts lights where your Lightkeeper devices want them right now, in one go. Use it when something else decides the moment — motion, a door, a button — and you want Lightkeeper to decide the light. The colour and the brightness can come from two different Lightkeeper devices, so a Room-sensing Light can set the level while a Circadian Light sets the white."
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "lights",
            "title": {
              "en": "Lights"
            },
            "placeholder": {
              "en": "A room, or one light"
            }
          },
          {
            "type": "autocomplete",
            "name": "colour",
            "title": {
              "en": "Colour from"
            },
            "placeholder": {
              "en": "A circadian or Colour Curve Light"
            }
          },
          {
            "type": "autocomplete",
            "name": "brightness",
            "title": {
              "en": "Brightness from"
            },
            "placeholder": {
              "en": "A Room-sensing Light, schedule or curve"
            }
          },
          {
            "type": "dropdown",
            "name": "power",
            "title": {
              "en": "The switch"
            },
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "Switch them on"
                }
              },
              {
                "id": "only_on",
                "title": {
                  "en": "Only lights already on"
                }
              }
            ]
          }
        ],
        "id": "set_lights"
      }
    ],
    "conditions": [
      {
        "id": "daylight_is_dark",
        "title": {
          "en": "It !{{is|is not}} dark enough"
        },
        "titleFormatted": {
          "en": "It !{{is|is not}} at [[level]] daylight or less"
        },
        "hint": {
          "en": "Compares against what this Room-sensing Light already reads — from its own light sensor, or from the sun where it has no sensor. 0% is fully dark outside and 100% fully bright, on that device's own thresholds, so the number you set here means the same thing as the brightness it chooses. If it cannot tell how light it is, this is never true."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=daylight"
          },
          {
            "type": "range",
            "name": "level",
            "title": {
              "en": "Daylight at or below"
            },
            "min": 0,
            "max": 1,
            "step": 0.05,
            "value": 0.25,
            "label": "%",
            "labelMultiplier": 100,
            "labelDecimals": 0
          }
        ]
      }
    ]
  },
