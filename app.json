            "type": "text",
            "name": "event_key",
            "title": {
              "en": "Event",
              "da": "Hændelse"
            }
          }
        ],
        "id": "bridge_event"
      },
      {
        "title": {
          "en": "Receive numeric controller event",
          "da": "Modtag numerisk hændelse fra betjening"
