{
  "id": "com.thomassidor.lightkeeper",
  "version": "0.2.2",
  "compatibility": ">=12.9.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Lightkeeper"
  },
  "description": {
    "en": "Dozens of Flows, or one app. Point any remote at any lights, and put those lights on a timer."
  },
  "category": ["tools", "lights"],
  "tags": {
    "en": ["remote control", "smart lights", "schedule", "timer", "time of day", "dimmer", "rotary dial",
      "button", "flow", "zigbee", "matter"]
  },
  "brandColor": "#1F3A5F",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas René Sidor"
  },
  "source": "https://github.com/thomassidor/lightkeeper",
  "homepage": "https://github.com/thomassidor/lightkeeper#readme",
  "support": "https://github.com/thomassidor/lightkeeper/issues",
  "bugs": {
    "url": "https://github.com/thomassidor/lightkeeper/issues"
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/"
    },
    "setCredential": {
      "method": "POST",
      "path": "/credential"
    },
    "deleteCredential": {
      "method": "DELETE",
      "path": "/credential"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "sweepOrphans": {
      "method": "POST",
      "path": "/orphans"
    },
    "countOrphans": {
      "method": "GET",
      "path": "/orphans"
    }
  }
}
