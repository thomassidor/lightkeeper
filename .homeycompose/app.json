  "homeyCommunityTopicId": 159938,
  "api": {
    "noteEvidence": {
      "method": "POST",
      "path": "/evidence/note"
    },
    "getEvidence": {
      "method": "GET",
      "path": "/evidence"
    },
    "startEvidence": {
      "method": "POST",
      "path": "/evidence/start"
    },
    "stopEvidence": {
      "method": "POST",
      "path": "/evidence/stop"
    },
    "clearEvidence": {
      "method": "DELETE",
      "path": "/evidence/:id"
    },
    "readEvidence": {
      "method": "GET",
      "path": "/evidence/:id/:offset/:end"
    },
    "getStatus": {
      "method": "GET",
      "path": "/"
    },
    "setCredential": {
      "method": "POST",
      "path": "/credential"
    },
    "deleteCredential": {
      "method": "DELETE",
      "path": "/credential"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "sweepOrphans": {
      "method": "POST",
      "path": "/orphans"
    },
    "countOrphans": {
      "method": "GET",
      "path": "/orphans"
    },
    "previewDevice": {
      "method": "POST",
      "path": "/devices/:id/preview"
    },
    "testPreStage": {
      "method": "POST",
      "path": "/devices/:id/prestage-test"
    },
    "tickCurves": {
      "method": "POST",
      "path": "/curves/tick"
    },
    "tickDaylight": {
      "method": "POST",
      "path": "/daylight/tick"
    },
    "testScheduleBoundary": {
      "method": "POST",
      "path": "/schedules/:id/test"
    },
    "setScheduleEntries": {
      "method": "POST",
      "path": "/schedules/:id/entries"
    },
    "testControllerFunction": {
      "method": "POST",
      "path": "/controllers/:id/test"
    },
    "getSensorHistory": {
      "method": "GET",
      "path": "/sensors/:id/history"
    }
  }
}
