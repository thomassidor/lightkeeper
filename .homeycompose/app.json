{
  "id": "com.thomassidor.lightlink",
  "version": "0.1.0",
  "compatibility": ">=12.3.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Light Link",
    "da": "Light Link"
  },
  "description": {
    "en": "Your remotes and lights, finally working together.",
    "da": "Dine fjernbetjeninger og lamper, endelig i samspil."
  },
  "category": "lights",
  "tags": {
    "en": ["remote control", "smart lights", "dimmer", "rotary dial", "button", "flow", "zigbee", "matter"],
    "da": ["fjernbetjening", "smartlys", "lysdæmper", "drejeknap", "trykknap", "flow", "zigbee", "matter"]
  },
  "brandColor": "#1F3A5F",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Thomas Sidor"
  },
  "source": "https://github.com/thomassidor/lightlink",
  "homepage": "https://github.com/thomassidor/lightlink#readme",
  "support": "https://github.com/thomassidor/lightlink/issues",
  "bugs": {
    "url": "https://github.com/thomassidor/lightlink/issues"
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/"
    },
    "setCredential": {
      "method": "POST",
      "path": "/credential"
    },
    "deleteCredential": {
      "method": "DELETE",
      "path": "/credential"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "sweepOrphans": {
      "method": "POST",
      "path": "/orphans"
    },
    "countOrphans": {
      "method": "GET",
      "path": "/orphans"
    }
  }
}
