# Normalise line endings in the repository, check out native on each platform.
* text=auto

# Explicit for the file types this project actually contains, so a Windows
# checkout and a CI runner on Linux agree on content hashes.
*.ts      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.html    text eol=lf
# views/shared/*.{css,js} are spliced BYTE-FOR-BYTE into the LF pair views by
# npm run sync:views, so a CRLF checkout of a source drifts every view.
*.css     text eol=lf
*.js      text eol=lf
*.yml     text eol=lf
*.svg     text eol=lf
*.txt     text eol=lf

# Binary — never touch.
*.png     binary
